# ─────────────────────────────────────────────────────────────────────────────
# FarmConnect Frontend – Environment Variable Template
# Copy this file to .env (or .env.local) and fill in the values.
# All variables MUST be prefixed with VITE_ to be exposed to the browser bundle.
# Never commit your real .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── API Base URL ──────────────────────────────────────────────────────────────
# The base URL of the FarmConnect backend API (no trailing slash)
# Example: http://localhost:5000/api   (local development)
#          https://api.farmconnect.example.com/api  (production)
VITE_API_BASE_URL=http://localhost:5000/api

# ── App Meta ─────────────────────────────────────────────────────────────────
# Application display name (used in page title, Navbar, etc.)
VITE_APP_NAME=FarmConnect

# ── Default Language ──────────────────────────────────────────────────────────
# Default UI language: en (English) | te (Telugu)
VITE_DEFAULT_LANG=en

# ── Cloudinary (read-only, public upload preset) ──────────────────────────────
# Cloudinary cloud name for the Cloudinary Upload Widget (if used client-side)
# Leave blank if all uploads are proxied through the backend
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# ── Feature Flags ─────────────────────────────────────────────────────────────
# Enable the Farmer Easy Mode feature (true | false)
VITE_EASY_MODE_ENABLED=true

# Enable the Group Buying feature (true | false)
VITE_GROUP_BUY_ENABLED=true
