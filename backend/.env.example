# ─────────────────────────────────────────────────────────────────────────────
# FarmConnect Backend – Environment Variable Template
# Copy this file to .env and fill in the values.
# Never commit your real .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
# Port the Express server listens on
PORT=5000

# Node environment: development | production | test
NODE_ENV=development

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Full MongoDB Atlas connection URI (include database name)
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/farmconnect?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/farmconnect?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────────────────────
# Secret used to sign access tokens (min 32 characters, high entropy)
JWT_ACCESS_SECRET=replace_with_a_strong_random_secret_at_least_32_chars

# Access token expiry (e.g. 15m, 1h)
JWT_ACCESS_EXPIRY=15m

# Secret used to sign refresh tokens (different from access secret, min 32 chars)
JWT_REFRESH_SECRET=replace_with_another_strong_random_secret_at_least_32_chars

# Refresh token expiry (e.g. 7d)
JWT_REFRESH_EXPIRY=7d

# ── CORS ─────────────────────────────────────────────────────────────────────
# Frontend origin allowed to make cross-origin requests
# Example: http://localhost:5173 for local Vite dev server
CORS_ORIGIN=http://localhost:5173

# ── Cloudinary ────────────────────────────────────────────────────────────────
# Cloudinary account cloud name (found in the Cloudinary dashboard)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# Cloudinary API key
CLOUDINARY_API_KEY=your_cloudinary_api_key

# Cloudinary API secret
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Maximum number of login attempts per IP per window
RATE_LIMIT_MAX_REQUESTS=10

# Rate limit window in milliseconds (default 15 minutes = 900000)
RATE_LIMIT_WINDOW_MS=900000

# ── Cookie ────────────────────────────────────────────────────────────────────
# Set to "true" in production to enforce Secure flag on the refresh-token cookie
COOKIE_SECURE=false
